@Main(){
    assertEquals([1,2,3].length,3)
    assertEquals([[[1,2,3]]].length,1)    
    
    assertEquals(3, [1,2,3].length)
    assertEquals(1, [[[1,2,3]]].length) 

    assertEquals(2, {"a":0,"b":2}.length)
    assertEquals({"a":0,"b":2}.length, 2)
    

    assertEquals({"a":{"a":[1,2,3]}}.length, 1)

    assignValue($var,[[[1,2,3]]])
    assertEquals($var.length, 1)
    assertEquals(1, $var.length)

    assignValue($var,[[[1,2,3]],true,false,[1,2,3]])
    assertEquals($var.length,4)
    assertEquals(4, $var.length)
    assertEquals($var[0].length,1)
    assertEquals($var[0][0].length,3)

    assertEquals($var[3].length,3)

    assignValue($i,0)
    assertEquals($var[$i + 2 - $i - 2][($i + 2 - $i - 2) * 0].length,3)
    assertEquals(3, $var[$i + 2 - $i - 2][($i + 2 - $i - 2) * 0].length)

    assignValue($l, $var.length)
    assertEquals($l,4)

    
}